# Local development defaults. Copy to .env and adjust.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# MySQL connection (required). Tests create and drop a test_<name> database, so the user needs CREATE rights.
DATABASE_URL=mysql://twigasoft:change-me@127.0.0.1:3306/twigasoft

# Public site address, used in password reset links
FRONTEND_URL=http://localhost:5173

# Only needed if the site calls the API from a different origin (comma-separated)
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

ADMIN_TOKEN_TTL_HOURS=12
PASSWORD_RESET_TIMEOUT=3600

# Console backend prints emails to the terminal; use SMTP in production
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=AFRIGULF Exchange <no-reply@example.com>
